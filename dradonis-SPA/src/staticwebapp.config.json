{
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": [
            "/assets/*",
            "*.css",
            "*.js",
            "*.svg",
            "*.png",
            "*.jpg",
            "*.ico",
            "*.woff",
            "*.woff2"
        ]
    },
    "routes": [
        {
            "route": "/assets/*",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "route": "/*.js",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "route": "/*.css",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "route": "/*.woff2",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "route": "/index.html",
            "headers": {
                "Cache-Control": "no-cache, must-revalidate"
            }
        }
    ],
    "globalHeaders": {
        "X-Content-Type-Options": "nosniff"
    }
}
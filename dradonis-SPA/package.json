{
  "name": "spike",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/generate-build-version.js",
    "start": "ng serve",
    "prebuild": "node scripts/generate-build-version.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev:ssr": "ng run Spike:serve-ssr",
    "serve:ssr": "node dist/Spike/server/main.js",

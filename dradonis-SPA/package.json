    "@types/date-fns": "^2.6.3",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.8",
    "@types/node": "^20.17.19",
    "browser-sync": "^3.0.0",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sharp": "^0.34.5",
    "typescript": "~5.8.3"
